# Copy to .env for local builds. In GitHub Actions set these as repository variables.

# Preview build (both languages in one site): where it is served from, for canonical URLs, hreflang and the sitemap.
SITE_URL=https://pandusss.github.io
# "/" for an own domain, "/<repo>/" for a GitHub Pages project site.
BASE_PATH=/himmash-site/

# Production: one site per language (npm run build:sites). The Russian site on .ru, the English one on .com;
# each links to the other. PUBLIC_SITE_LANG (ru / en) is set by scripts/build-sites.mjs.
PUBLIC_SITE_URL_RU=
PUBLIC_SITE_URL_EN=

# Where the inquiry form posts (FormData, Accept: application/json). Personal data law (152-FZ)
# requires the handler to run on a server in Russia, e.g. a PHP script on Russian hosting.
# Production builds set /api/send-form.php themselves when FORM_TO is given. Empty: the visitor's mail app opens instead.
PUBLIC_FORM_ENDPOINT=
# Optional key sent as a hidden "access_key" field, if the handler expects one.
PUBLIC_FORM_ACCESS_KEY=

# "true" for preview deployments that must not be indexed by search engines.
PUBLIC_NOINDEX=

# Web analytics, loaded only after the visitor accepts cookies (see src/data/analytics.ts).
# Yandex Metrika counter number for the Russian site, Google Analytics 4 measurement IDs (G-…) for the English one and,
# optionally, the Russian one (in addition to Metrika; the privacy policy then names the cross-border transfer).
PUBLIC_YANDEX_METRIKA_ID=
PUBLIC_GA_ID=
PUBLIC_GA_ID_RU=
# Ownership meta tags for Yandex Webmaster and Google Search Console (the content="…" value they give).
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GOOGLE_VERIFICATION=

# Form handler settings for production builds (scripts/form-config.mjs): where requests go, the sender address on a
# domain whose SPF allows the hosting, and every domain the form is accepted from.
FORM_TO=
FORM_FROM=
FORM_ORIGINS=
