---
import { rootLang } from '../../i18n';
import ArticleView from '../../views/ArticleView.astro';
import { getArticles, articleSlug } from '../../data/articles';
export async function getStaticPaths() {
  return (await getArticles(rootLang)).map((article) => ({ params: { slug: articleSlug(article) }, props: { article } }));
}
---
<ArticleView lang={rootLang} article={Astro.props.article} />
