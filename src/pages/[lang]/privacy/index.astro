---
import LegalView from '../../../views/LegalView.astro';
import { type Lang, prefixedLangs } from '../../../i18n';
export function getStaticPaths() {
  return prefixedLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---
<LegalView lang={lang} doc="privacy" />
