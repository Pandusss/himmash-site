---
import Base from '../layouts/Base.astro';
import { localePath, useTranslations } from '../i18n';

// GitHub Pages serves this file for every missing URL, so it links to all languages.
const t = useTranslations('ru');
const en = useTranslations('en');
const zh = useTranslations('zh');
---
<Base lang="ru" path="/" title={t.notFound.metaTitle} description={t.notFound.text} alternates={['ru']} noindex>
  <section class="wrap not-found">
    <div class="eyebrow">404</div>
    <h1 set:html={t.notFound.title} />
    <p>{t.notFound.text}</p>
    <div class="hero-actions">
      <a class="btn" href={localePath('ru', '/')}>{t.notFound.home} <span class="arrow" aria-hidden="true">↗</span></a>
      <a class="text-link" href={localePath('ru', '/equipment/')}>{t.notFound.catalog} <span aria-hidden="true">↗</span></a>
    </div>
    <p class="not-found-langs">
      <a href={localePath('en', '/')} lang="en">{en.notFound.home} — English</a>
      <a href={localePath('zh', '/')} lang="zh-CN">{zh.notFound.home} — 中文</a>
    </p>
  </section>
</Base>
