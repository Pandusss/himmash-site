---
import Base from '../layouts/Base.astro';
import { locales, rootLang, langMeta, localePath, useTranslations } from '../i18n';

// The host serves this file for every missing URL: it is in the site's language and links to the other ones.
const t = useTranslations(rootLang);
const others = locales.filter((l) => l !== rootLang);
---
<Base lang={rootLang} path="/" title={t.notFound.metaTitle} description={t.notFound.text} alternates={[rootLang]} noindex>
  <section class="wrap not-found">
    <div class="eyebrow">404</div>
    <h1 set:html={t.notFound.title} />
    <p>{t.notFound.text}</p>
    <div class="hero-actions">
      <a class="btn" href={localePath(rootLang, '/')}>{t.notFound.home} <span class="arrow" aria-hidden="true">↗</span></a>
      <a class="text-link" href={localePath(rootLang, '/equipment/')}>{t.notFound.catalog} <span aria-hidden="true">↗</span></a>
    </div>
    <p class="not-found-langs">
      {others.map((l) => <a href={localePath(l, '/')} lang={langMeta[l].htmlLang}>{useTranslations(l).notFound.home} — {langMeta[l].name}</a>)}
    </p>
  </section>
</Base>
