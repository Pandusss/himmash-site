---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactCta from '../components/ContactCta.astro';
import CatalogFilters from '../components/CatalogFilters.astro';
import { type Lang, localePath, asset, useTranslations } from '../i18n';
import { products, productText, quickLabel } from '../data/products';
import { breadcrumbJsonLd } from '../data/company';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const e = t.equipment;
const crumbs = [
  { name: t.product.home, href: localePath(lang, '/') },
  { name: t.product.equipment, href: localePath(lang, '/equipment/') },
];
const absolute = (href: string) => new URL(href, Astro.site).href;
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: productText(p.slug, lang).name, url: absolute(localePath(lang, `/equipment/${p.slug}/`)) })),
};
---
<Base lang={lang} path="/equipment/" title={e.metaTitle} description={e.metaDescription} jsonLd={[breadcrumbJsonLd(crumbs, absolute), itemList]}>
  <div class="wrap">
    <Breadcrumbs label={t.nav.breadcrumbs} items={[crumbs[0], { name: t.product.equipment }]} />
    <header class="page-head">
      <div class="eyebrow">{e.eyebrow}</div>
      <h1 set:html={e.title} />
      <p>{e.lead}</p>
    </header>
  </div>
  <section class="section catalog catalog-page" data-catalog aria-label={e.eyebrow}>
    <div class="wrap">
      <CatalogFilters lang={lang} views />
      <div class="product-grid" data-view-panel="cards">
        {products.map((p, i) => <ProductCard product={p} lang={lang} headingLevel="h2" priority={i === 0 ? 'high' : undefined} />)}
        <div class="custom-tile">
          <div class="eyebrow">{t.home.hero.eyebrow}</div>
          <h2>{e.customTitle}</h2>
          <p>{e.customText}</p>
          <button class="btn light" type="button" data-inquiry={t.form.defaultSubject}>{e.customButton} <span class="arrow" aria-hidden="true">↗</span></button>
        </div>
      </div>
      <div class="catalog-table-wrap" data-view-panel="table" hidden>
        <table class="catalog-table">
          <thead>
            <tr><th scope="col">{e.colName}</th><th scope="col">{e.colCategory}</th><th scope="col">{e.colKey}</th><th scope="col">{e.colPrice}</th><th scope="col">{e.colDelivery}</th></tr>
          </thead>
          <tbody>
            {products.map((p) => {
              const x = productText(p.slug, lang);
              const key = x.quick?.[0];
              return (
                <tr data-category={p.category}>
                  <th scope="row">
                    <a href={localePath(lang, `/equipment/${p.slug}/`)}>
                      <img src={asset(`img/${p.image}`)} width="96" height="54" alt="" loading="lazy" decoding="async">
                      <span>{x.short}</span>
                    </a>
                  </th>
                  <td>{t.categories[p.category]}</td>
                  <td>{key ? <><b>{key.value}{key.unit && ` ${key.unit}`}</b><small>{quickLabel(key.label)}</small></> : '—'}</td>
                  <td>{x.price ? <><b>{x.price}</b>{x.priceNote && <small>{x.priceNote}</small>}</> : <b>{t.product.onRequest}</b>}</td>
                  <td>{x.deliveryTime ?? '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="catalog-note">{e.priceNote}</p>
    </div>
  </section>
  <ContactCta lang={lang} />
</Base>
