---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ContactCta from '../components/ContactCta.astro';
import { type Lang, localePath, asset, formatDate, langMeta, useTranslations } from '../i18n';
import { type Article, articleSlug, articleLanguages, getArticles, readingMinutes } from '../data/articles';
import { productBySlug } from '../data/products';
import { imageSize, responsiveSrcset } from '../data/images';
import { breadcrumbJsonLd, company } from '../data/company';

interface Props { lang: Lang; article: Article }
const { lang, article } = Astro.props;
const t = useTranslations(lang);
const a = t.articles;
const slug = articleSlug(article);
const path = `/articles/${slug}/`;
const { Content, headings } = await render(article);
const toc = headings.filter((h: { depth: number }) => h.depth === 2);
const alternates = await articleLanguages(slug);
const related = article.data.products.map(productBySlug);
const more = (await getArticles(lang)).filter((other) => articleSlug(other) !== slug).slice(0, 2);
const absolute = (href: string) => new URL(href, Astro.site).href;
const coverSize = await imageSize(article.data.cover);
const coverSrcset = await responsiveSrcset(article.data.cover, asset);
const crumbs = [
  { name: t.product.home, href: localePath(lang, '/') },
  { name: t.nav.articles, href: localePath(lang, '/articles/') },
  { name: article.data.title, href: localePath(lang, path) },
];
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  image: absolute(asset(article.data.cover)),
  datePublished: isoDate(article.data.date),
  dateModified: isoDate(article.data.updated ?? article.data.date),
  inLanguage: langMeta[lang].htmlLang,
  mainEntityOfPage: absolute(localePath(lang, path)),
  author: { '@type': 'Organization', name: company.name[lang] },
  publisher: { '@type': 'Organization', name: company.name[lang], logo: { '@type': 'ImageObject', url: absolute(asset('img/logo-01-122x122.webp')) } },
};
---
<Base lang={lang} path={path} title={`${article.data.title} — ${t.meta.brandShort}`} description={article.data.description} image={article.data.cover} type="article" alternates={alternates} inquirySubject={article.data.title} jsonLd={[breadcrumbJsonLd(crumbs, absolute), articleJsonLd]}>
  <meta slot="head" property="article:published_time" content={isoDate(article.data.date)}>
  <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>
  <div class="wrap">
    <Breadcrumbs label={t.nav.breadcrumbs} items={[crumbs[0], crumbs[1], { name: article.data.title }]} />
    <header class="article-head">
      <div class="eyebrow"><time datetime={isoDate(article.data.date)}>{formatDate(article.data.date, lang)}</time> · {readingMinutes(article)} {a.minutes}</div>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
    </header>
    <figure class="article-cover">
      <img src={asset(article.data.cover)} srcset={coverSrcset} sizes="(max-width: 1360px) calc(100vw - 40px), 1320px" width={coverSize.width} height={coverSize.height} alt={article.data.coverAlt} fetchpriority="high">
    </figure>
    {toc.length > 1 && (
      <details class="toc-mobile">
        <summary><span class="eyebrow">{a.toc}</span><span class="faq-icon" aria-hidden="true"></span></summary>
        <ol>{toc.map((h: { slug: string; text: string }) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>
    )}
    <div class="article-layout">
      <aside class="article-aside">
        {toc.length > 1 && (
          <nav class="toc" aria-labelledby="toc-title">
            <div class="eyebrow" id="toc-title">{a.toc}</div>
            <ol>{toc.map((h: { slug: string; text: string }) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="aside-cta">
          <p>{a.ctaText}</p>
          <button class="btn full" type="button" data-inquiry={article.data.title}>{a.ctaButton} <span class="arrow" aria-hidden="true">↗</span></button>
        </div>
      </aside>
      <article class="prose">
        <Content />
      </article>
    </div>
    {related.length > 0 && (
      <section class="section section-flush related" aria-labelledby="related-title">
        <div class="section-head"><div><div class="eyebrow">{a.relatedEquipment}</div><h2 id="related-title" set:html={t.product.relatedTitle} /></div></div>
        <div class="product-grid">{related.map((p) => <ProductCard product={p} lang={lang} />)}</div>
      </section>
    )}
    {more.length > 0 && (
      <section class="section section-flush" aria-labelledby="more-title">
        <div class="section-head"><div><div class="eyebrow">{a.eyebrow}</div><h2 id="more-title">{a.more}</h2></div><a class="text-link" href={localePath(lang, '/articles/')}>{a.all} <span aria-hidden="true">↗</span></a></div>
        <div class="article-grid two">{more.map((other) => <ArticleCard article={other} lang={lang} />)}</div>
      </section>
    )}
  </div>
  <ContactCta lang={lang} title={a.ctaTitle} text={a.ctaText} button={a.ctaButton} subject={article.data.title} />
</Base>
