---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { domainToUnicode } from 'node:url';
import { type Lang, localePath, siteUrl, useTranslations } from '../i18n';
import { legalTexts } from '../data/legal';
import { countersFor } from '../data/analytics';
import { company } from '../data/company';

interface Props { lang: Lang; doc: 'privacy' | 'consent' }
const { lang, doc } = Astro.props;
const t = useTranslations(lang);
const l = t.legal;
const title = doc === 'privacy' ? l.privacyTitle : l.consentTitle;
const description = doc === 'privacy' ? l.privacyMeta : l.consentMeta;
// The documents name the site in this language: its own domain, or the address of this build.
const domain = domainToUnicode(new URL(siteUrl(lang) ?? Astro.site!).hostname);
const fill = (text: string) => text.replaceAll('{site}', domain).replaceAll('{email}', company.email);
const counters = countersFor(lang);
const withAnalytics = counters.length > 0, withGa = counters.some((c) => c.provider === 'ga'), withMetrika = counters.some((c) => c.provider === 'metrika');
const sections = legalTexts[lang][doc].filter((s) => (s.analytics === undefined || s.analytics === withAnalytics) && (s.ga === undefined || s.ga === withGa) && (s.metrika === undefined || s.metrika === withMetrika));
const other = doc === 'privacy'
  ? { href: localePath(lang, '/consent/'), label: l.consentTitle }
  : { href: localePath(lang, '/privacy/'), label: l.privacyTitle };
---
<Base lang={lang} path={`/${doc}/`} title={`${title} — ${t.meta.brandShort}`} description={description}>
  <div class="wrap">
    <Breadcrumbs label={t.nav.breadcrumbs} items={[{ name: t.product.home, href: localePath(lang, '/') }, { name: title }]} />
    <header class="page-head legal-head">
      <div class="eyebrow">{l.eyebrow}</div>
      <h1>{title}</h1>
    </header>
    <article class="prose legal-text">
      {sections.map((s) => (
        <>
          {s.heading && <h2>{s.heading}</h2>}
          {s.paragraphs?.map((p) => <p>{fill(p)}</p>)}
          {s.bullets && <ul>{s.bullets.map((b) => <li>{fill(b)}</li>)}</ul>}
        </>
      ))}
      <p><a href={other.href}>{other.label}</a></p>
    </article>
  </div>
</Base>
