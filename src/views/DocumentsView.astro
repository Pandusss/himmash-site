---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactCta from '../components/ContactCta.astro';
import { type Lang, localePath, asset, useTranslations } from '../i18n';
import { documents, documentText } from '../data/documents';
import { breadcrumbJsonLd } from '../data/company';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const d = t.documents;
const crumbs = [
  { name: t.product.home, href: localePath(lang, '/') },
  { name: t.nav.documents, href: localePath(lang, '/certificates/') },
];
const absolute = (href: string) => new URL(href, Astro.site).href;
---
<Base lang={lang} path="/certificates/" title={d.metaTitle} description={d.metaDescription} jsonLd={[breadcrumbJsonLd(crumbs, absolute)]}>
  <div class="wrap">
    <Breadcrumbs label={t.nav.breadcrumbs} items={[crumbs[0], { name: t.nav.documents }]} />
    <header class="page-head">
      <div class="eyebrow">{d.eyebrow}</div>
      <h1 set:html={d.title} />
      <p>{d.lead}</p>
    </header>
    <nav class="doc-index" aria-label={d.eyebrow}>
      {documents.map((doc, i) => { const text = documentText(doc.id, lang); return (
        <a href={`#${doc.id}`}><span class="num">0{i + 1}</span><span>{text.title}<small>{text.kind} · {doc.years}</small></span></a>
      ); })}
    </nav>
  </div>

  {documents.map((doc, i) => {
    const text = documentText(doc.id, lang);
    const caption = `${text.title} · ${doc.years}`;
    return (
      <section class="doc-section" id={doc.id} aria-labelledby={`${doc.id}-title`}>
        <div class="wrap">
          <div class="doc-heading">
            <span class="eyebrow">0{i + 1} — {text.kind}</span>
            <h2 id={`${doc.id}-title`}>{text.title}</h2>
            <div class="doc-badges">
              <span class="badge">{doc.years}</span>
              {doc.archive && <span class="badge muted">{d.archive}</span>}
            </div>
          </div>
          <div class="doc-pair">
            <figure class="doc-original">
              <figcaption class="doc-label">{d.original} · RU</figcaption>
              <button class="doc-scan" type="button" data-media={asset(`img/docs/${doc.image}`)} data-caption={caption} data-gallery="certificates" aria-label={`${d.zoom}: ${text.title}`}>
                <img src={asset(`img/docs/${doc.image}`)} width={doc.width} height={doc.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" alt={caption} lang="ru">
                <span class="zoom-label" aria-hidden="true">+</span>
              </button>
            </figure>
            <article class="doc-text">
              <div class="doc-text-head">
                <div class="doc-label">{d.translation}</div>
              </div>
              {/* Each site shows the text in its own language only. */}
              <div class="doc-version">
                <p class="doc-header">{text.header}</p>
                <h3>{text.heading}</h3>
                <dl class="doc-fields">
                  {text.fields.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
                </dl>
                {text.footer && <p class="doc-footer">{text.footer}</p>}
              </div>
              <p class="doc-note">{d.note}</p>
            </article>
          </div>
        </div>
      </section>
    );
  })}

  <ContactCta lang={lang} />
</Base>
