---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductCard from '../components/ProductCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ContactCta from '../components/ContactCta.astro';
import CatalogFilters from '../components/CatalogFilters.astro';
import CertificateGallery from '../components/CertificateGallery.astro';
import { type Lang, localePath, asset, useTranslations } from '../i18n';
import { products, processSteps, processLoop, productText } from '../data/products';
import { getArticles } from '../data/articles';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const articles = (await getArticles(lang)).slice(0, 3);
const solutions = [
  { href: localePath(lang, '/equipment/granulation-lines/'), image: 'img/products/01-02-1200.webp' },
  { href: localePath(lang, '/equipment/'), image: 'img/products/02-01-1200x900.webp' },
  { href: '#modernization', image: 'img/products/11-01-1200.webp' },
];
// "до 95" → small "до" + large "95".
const statPrefix = (value: string) => value.match(/^(\D+?)\s*(?=\d)/)?.[1] ?? '';
const statNumber = (value: string) => value.slice(statPrefix(value).length).trim();
const productLink = (slug: string) => ({ href: localePath(lang, `/equipment/${slug}/`), name: productText(slug, lang).short });
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---
<Base lang={lang} path="/" title={t.meta.homeTitle} description={t.meta.homeDescription} jsonLd={[faqJsonLd]}>
  <section class="hero wrap" aria-labelledby="home-title">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> {h.hero.eyebrow}</div>
        <h1 id="home-title" set:html={h.hero.title} />
        <p set:html={h.hero.lead} />
        <div class="hero-actions">
          <button class="btn" type="button" data-inquiry={t.form.defaultSubject}>{h.hero.cta} <span class="arrow" aria-hidden="true">↗</span></button>
          <a class="text-link" href="#catalog">{h.hero.secondary} <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-footnote" set:html={h.hero.footnote} />
      </div>
      <div class="hero-media">
        <img src={asset('img/bg-02-1920x1080.webp')} srcset={`${asset('img/bg-02-960.webp')} 960w, ${asset('img/bg-02-1440.webp')} 1440w, ${asset('img/bg-02-1920x1080.webp')} 1920w`} sizes="(max-width: 650px) 100vw, 50vw" width="1920" height="1080" alt={h.hero.photoAlt} fetchpriority="high">
        <span class="photo-label">{h.hero.photoLabel}</span>
        <div class="photo-caption">
          <div><p set:html={h.hero.photoCaption} /><small>{h.hero.photoSmall}</small></div>
          <span class="photo-cross" aria-hidden="true">+</span>
        </div>
      </div>
    </div>
    <dl class="stats">
      {h.stats.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd class="stat-value">{statPrefix(s.value) && <span class="stat-prefix">{statPrefix(s.value)}</span>}<span class="stat-num" data-countup>{statNumber(s.value)}</span>{s.unit && <small>{s.unit}</small>}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section solutions wrap" aria-labelledby="solutions-title" data-reveal>
    <SectionHead id="solutions-title" eyebrow={h.solutions.eyebrow} title={h.solutions.title} lead={h.solutions.lead} />
    <div class="solution-cards">
      {h.solutions.items.map((s, i) => (
        <a class="solution-card" href={solutions[i].href}>
          <div class="solution-image"><img src={asset(solutions[i].image)} alt={h.solutions.imageAlts[i]} loading="lazy" decoding="async"></div>
          <div class="solution-body">
            <div class="eyebrow">{s.eyebrow}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="text-link">{s.link} <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section materials-section" aria-labelledby="materials-title" data-reveal>
    <div class="wrap">
      <SectionHead id="materials-title" eyebrow={h.materials.eyebrow} title={h.materials.title} lead={h.materials.lead} />
      <ul class="feedstock-grid">
        {h.materials.items.map((m) => (
          <li class="feedstock">
            <span class="feedstock-code">{m.code}</span>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section wrap process-section" aria-labelledby="process-title" data-reveal>
    <SectionHead id="process-title" eyebrow={h.process.eyebrow} title={h.process.title} lead={h.process.lead} />
    <ol class="process">
      {h.process.steps.map((step, i) => (
        <li class="process-step">
          <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          <ul class="process-links">
            {processSteps[i].map((slug) => { const l = productLink(slug); return <li><a href={l.href}>{l.name} <span aria-hidden="true">↗</span></a></li>; })}
          </ul>
        </li>
      ))}
    </ol>
    <div class="process-loop">
      <span class="process-loop-mark" aria-hidden="true">↺</span>
      <div><b>{h.process.loop.title}</b><p>{h.process.loop.text}</p></div>
      {processLoop.map((slug) => { const l = productLink(slug); return <a class="text-link" href={l.href}>{l.name} <span aria-hidden="true">↗</span></a>; })}
    </div>
  </section>

  <section id="catalog" class="section catalog catalog-home" aria-labelledby="catalog-title" data-catalog data-limit="6" data-reveal>
    <div class="wrap">
      <SectionHead id="catalog-title" eyebrow={h.catalog.eyebrow} title={h.catalog.title} lead={h.catalog.lead} />
      <CatalogFilters lang={lang} />
      <div class="product-grid">
        {products.map((p) => <ProductCard product={p} lang={lang} />)}
      </div>
      <div class="catalog-bottom">
        <button class="btn secondary" type="button" data-show-more>{h.catalog.showAll} <span aria-hidden="true">↓</span></button>
        <a class="btn secondary catalog-link-mobile" href={localePath(lang, '/equipment/')}>{t.footer.catalog} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="modernization" class="section wrap" aria-labelledby="modernization-title" data-reveal>
    <div class="modernize">
      <div class="modernize-copy">
        <div class="eyebrow">{h.modernization.eyebrow}</div>
        <h2 id="modernization-title" set:html={h.modernization.title} />
        <p>{h.modernization.text}</p>
        <button class="btn light" type="button" data-inquiry={t.form.modernizationSubject}>{h.modernization.cta} <span class="arrow" aria-hidden="true">↗</span></button>
      </div>
      <img src={asset('img/products/02-02-1200x900.webp')} width="1200" height="900" loading="lazy" decoding="async" alt={h.modernization.imageAlt}>
    </div>
  </section>

  <section class="section wrap steps-section" aria-labelledby="steps-title" data-reveal>
    <SectionHead id="steps-title" eyebrow={h.steps.eyebrow} title={h.steps.title} />
    <div class="steps">
      {h.steps.items.map((s) => (
        <article class="step"><span class="number">{s.label}</span><h3 set:html={s.title} /><p>{s.text}</p></article>
      ))}
    </div>
  </section>

  <section id="about" class="section about" aria-labelledby="about-title" data-reveal>
    <div class="wrap about-grid">
      <div>
        <div class="eyebrow">{h.about.eyebrow}</div>
        <h2 id="about-title" set:html={h.about.title} />
        {h.about.paragraphs.map((para) => <p>{para}</p>)}
        <div class="about-facts">
          {h.about.facts.map((f) => <div><strong>{f.title}</strong><small>{f.text}</small></div>)}
        </div>
      </div>
      <figure class="about-photo">
        <img src={asset('img/covers/line-upgrade-1600.webp')} srcset={`${asset('img/covers/line-upgrade-800.webp')} 800w, ${asset('img/covers/line-upgrade-1600.webp')} 1600w`} sizes="(max-width: 920px) 100vw, 50vw" width="1600" height="750" loading="lazy" decoding="async" alt={h.about.photoAlt}>
      </figure>
    </div>
  </section>

  <section id="certificates" class="section certificates-section" aria-labelledby="certificates-title" data-reveal>
    <div class="wrap">
      <SectionHead id="certificates-title" eyebrow={h.certificates.eyebrow} title={h.certificates.title} lead={h.certificates.lead} />
      <CertificateGallery lang={lang} />
      <div class="catalog-bottom">
        <a class="btn secondary" href={localePath(lang, '/certificates/')}>{h.certificates.all} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section articles-teaser" aria-labelledby="articles-title" data-reveal>
      <div class="wrap">
        <SectionHead id="articles-title" eyebrow={h.articles.eyebrow} title={h.articles.title} lead={h.articles.lead} />
        <div class="article-grid">
          {articles.map((a) => <ArticleCard article={a} lang={lang} />)}
        </div>
        <div class="catalog-bottom">
          <a class="btn secondary" href={localePath(lang, '/articles/')}>{h.articles.all} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  )}

  <section class="section wrap faq-section" aria-labelledby="faq-title" data-reveal>
    <div class="faq-layout">
      <div>
        <div class="eyebrow">{h.faq.eyebrow}</div>
        <h2 id="faq-title" set:html={h.faq.title} />
      </div>
      <div class="faq-list">
        {t.faq.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary><span>{item.q}</span><span class="faq-icon" aria-hidden="true"></span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactCta lang={lang} />
</Base>
