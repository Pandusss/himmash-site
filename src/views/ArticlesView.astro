---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ContactCta from '../components/ContactCta.astro';
import { type Lang, localePath, useTranslations } from '../i18n';
import { getArticles } from '../data/articles';
import { breadcrumbJsonLd } from '../data/company';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = t.articles;
const articles = await getArticles(lang);
const crumbs = [
  { name: t.product.home, href: localePath(lang, '/') },
  { name: t.nav.articles, href: localePath(lang, '/articles/') },
];
const absolute = (href: string) => new URL(href, Astro.site).href;
---
<Base lang={lang} path="/articles/" title={a.metaTitle} description={a.metaDescription} jsonLd={[breadcrumbJsonLd(crumbs, absolute)]}>
  <div class="wrap">
    <Breadcrumbs label={t.nav.breadcrumbs} items={[crumbs[0], { name: t.nav.articles }]} />
    <header class="page-head">
      <div class="eyebrow">{a.eyebrow}</div>
      <h1 set:html={a.title} />
      <p>{a.lead}</p>
    </header>
    <div class="article-grid article-grid-page">
      {articles.map((article) => <ArticleCard article={article} lang={lang} headingLevel="h2" />)}
    </div>
  </div>
  <ContactCta lang={lang} title={a.ctaTitle} text={a.ctaText} button={a.ctaButton} />
</Base>
