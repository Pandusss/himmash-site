---
import { type Lang, localePath, useTranslations } from '../i18n';
import { company, phoneDisplay, presentationFor } from '../data/company';
import { analyticsFor } from '../data/analytics';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const presentation = presentationFor(lang);
---
<footer class="site-footer" id="contacts">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="footer-brand" href={localePath(lang, '/')}>{t.brand.name}</a>
        <p class="footer-tagline">{t.footer.tagline}</p>
        <a class="text-link footer-link" href={localePath(lang, '/equipment/')}>{t.footer.catalog} <span aria-hidden="true">↗</span></a>
        {presentation && <a class="text-link footer-link small" href={presentation.href} target="_blank" rel="noopener" type="application/pdf">{t.presentation.short} · {t.presentation.format} <span aria-hidden="true">↗</span></a>}
      </div>
      <div class="footer-contact">
        <div class="footer-label">{t.footer.discuss}</div>
        <a href={`tel:${company.phone}`}>{phoneDisplay(lang)}</a>
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </div>
      <div class="footer-address">
        <div class="footer-label">{t.footer.company}</div>
        <Fragment set:html={t.contact.address} />
        <small set:html={t.contact.hoursLong} />
        <a class="text-link footer-link small" href={company.route} target="_blank" rel="noopener">{t.footer.route} <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="footer-nav" aria-label={t.footer.sections}>
        <div class="footer-label">{t.footer.sections}</div>
        <a href={localePath(lang, '/equipment/')}>{t.nav.equipment}</a>
        <a href={localePath(lang, '/#modernization')}>{t.nav.modernization}</a>
        <a href={localePath(lang, '/#about')}>{t.nav.about}</a>
        <a href={localePath(lang, '/certificates/')}>{t.nav.documents}</a>
        <a href={localePath(lang, '/articles/')}>{t.nav.articles}</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span class="footer-legal">
        <span>{t.footer.rights}, {year}</span>
        <a href={localePath(lang, '/privacy/')}>{t.footer.privacy}</a>
        <a href={localePath(lang, '/consent/')}>{t.footer.consent}</a>
        {analyticsFor(lang) && <button type="button" class="footer-cookie" data-cookie-settings>{t.cookies.settings}</button>}
      </span>
    </div>
  </div>
</footer>
