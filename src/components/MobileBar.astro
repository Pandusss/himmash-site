---
import { type Lang, useTranslations } from '../i18n';
import { company } from '../data/company';

interface Props { lang: Lang; subject?: string }
const { lang } = Astro.props;
const t = useTranslations(lang);
const { subject = t.form.defaultSubject } = Astro.props;
---
<div class="mobile-bar" aria-label={t.home.contactCta.eyebrow} role="group">
  <a href={`tel:${company.phone}`}><span aria-hidden="true">☎</span>{t.mobileBar.call}</a>
  <a href={company.max} target="_blank" rel="noopener"><span aria-hidden="true">✉</span>{t.mobileBar.max}</a>
  <button type="button" class="mobile-bar-main" data-inquiry={subject}>{t.mobileBar.request} <span aria-hidden="true">↗</span></button>
</div>
