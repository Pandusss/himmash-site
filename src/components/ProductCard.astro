---
import { type Lang, localePath, asset, useTranslations } from '../i18n';
import { type ProductMeta, productText, quickLabel } from '../data/products';

/** priority: the card is on the first screen — load its photo eagerly ('high' for the very first one). */
interface Props { product: ProductMeta; lang: Lang; headingLevel?: 'h2' | 'h3'; priority?: 'high' | 'eager' }
const { product, lang, headingLevel = 'h3', priority } = Astro.props;
const t = useTranslations(lang);
const text = productText(product.slug, lang);
const Heading = headingLevel;
// One template for every card: up to two key figures, then the price or "on request".
const keys = (text.quick ?? []).slice(0, 2).map((q) => ({ label: quickLabel(q.label), value: q.unit ? `${q.value} ${q.unit}` : q.value }));
const price = text.price ?? t.product.onRequest;
const numericPrice = /\d/.test(price);
---
<a class="product-card" href={localePath(lang, `/equipment/${product.slug}/`)} data-category={product.category}>
  <div class="product-image">
    <img src={asset(`img/${product.image}`)} width="696" height="392" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority === 'high' ? 'high' : undefined} decoding="async" alt={text.name} style={`view-transition-name: pimg-${product.slug}`}>
    <span class="corner" aria-hidden="true">↗</span>
  </div>
  <div class="product-info">
    <div class="eyebrow">{t.categories[product.category]}</div>
    <Heading>{text.short}</Heading>
    <p>{text.card}</p>
    <dl class="product-meta">
      {keys.map((k) => <div><dt>{k.label}</dt><dd>{k.value}</dd></div>)}
      <div class:list={['product-price', { muted: !numericPrice }]}><dt>{t.product.price}</dt><dd>{price}</dd></div>
    </dl>
  </div>
</a>
