---
// Interactive isometric drawing of a machine, built with the anatomy kit (see figures/README.md).
// The page carries only the card; the drawing and its script are fetched when the section nears the viewport.
import { type Lang, asset } from '../i18n';
import { figureById } from '../figures';

interface Props { lang: Lang; id: string; num: string }
const { lang, id, num } = Astro.props;
const { text, data } = figureById(id)!;
const t = text[lang];
const payload = JSON.stringify({ ...t.live, label: t.label });
const { width, height, ...rest } = data;
const controlsLabel = { ru: 'Управление схемой', en: 'Figure controls', zh: '示意图操作' }[lang];
---
<section id="how-it-works" class="section details-layout anatomy-section" aria-labelledby="how-title">
  <div class="anatomy-intro">
    <div class="eyebrow muted">{num} — {t.eyebrow}</div>
    <h2 id="how-title" set:html={t.heading} />
    <p class="anatomy-lead">{t.intro}</p>
    <ul class="anatomy-keys">
      {t.keys.map((key) => <li data-mark={key.mark}><svg viewBox="0 0 16 10" aria-hidden="true"><path d="M2 4.5 8 1.5 14 4.5 14 6 8 9 2 6Z" /><path d="M2 4.5 8 7.5 14 4.5" /></svg>{key.label}</li>)}
    </ul>
  </div>
  <figure class="anatomy">
    <div class="anatomy-plate">
      <div class="anatomy-head" aria-hidden="true">{t.title}</div>
      <div class="anatomy-stage" tabindex="0" role="group" aria-label={t.aria} aria-busy="true" data-hint={t.controls ? undefined : ''} data-figure-id={id} data-src={asset(`figures/${id}.svg`)} data-text={payload} data-figure={JSON.stringify(rest)} style={`aspect-ratio:${width}/${height}`}>
        <span class="anatomy-live" aria-live="polite"></span>
        <span class="anatomy-loading">{t.loading}</span>
      </div>
      {t.controls && (
        <div class="anatomy-controls" role="group" aria-label={controlsLabel}>
          {t.controls.map((c: { key: string; label: string; flash?: string }) => <button type="button" class="anatomy-control" data-key={c.key} data-flash={c.flash}>{c.label}</button>)}
        </div>
      )}
      <div class="anatomy-foot">{!t.controls && <button type="button" class="anatomy-hint" data-key={t.hintKey ?? ' '}>{t.hint}</button>}<span data-readout aria-hidden="true">{t.idle}</span></div>
    </div>
    <figcaption class="anatomy-caption">{t.caption}</figcaption>
  </figure>
</section>

<script>
  import '../figures/loader.js';
</script>

<style>
  .anatomy-section { align-items: start; }
  .anatomy-lead { color: var(--muted); font-size: 15px; margin-top: 18px; max-width: 34ch; }
  .anatomy-keys { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 12px; font-size: 14px; color: var(--muted); max-width: 34ch; }
  .anatomy-keys li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; line-height: 1.45; }
  .anatomy-keys svg { width: 18px; margin-top: 3px; fill: var(--white); stroke: var(--muted); stroke-width: 1; stroke-linejoin: round; }
  .anatomy-keys [data-mark='lit'] svg { stroke: var(--green); stroke-width: 1.4; }
  .anatomy { margin: 0; width: 100%; max-width: 560px; }
  .anatomy-plate { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px 16px; }
  .anatomy-head, .anatomy-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; font: 11px/1.4 var(--font-mono); letter-spacing: .06em; color: var(--muted); }
  .anatomy-head { text-transform: uppercase; }
  /* The hint names the part to press; it also works as a button and lights the clickable parts on hover. */
  .anatomy-hint { display: inline-flex; align-items: center; gap: 8px; margin: -6px 0 -6px -8px; padding: 6px 8px; border: 0; border-radius: 4px; background: none; font: inherit; letter-spacing: inherit; text-transform: uppercase; color: var(--green); cursor: pointer; text-align: left; }
  .anatomy-hint::before { content: ""; flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 0 currentColor; animation: anatomy-dot 1.8s ease-out infinite; }
  .anatomy-hint:hover, .anatomy-hint:focus-visible { background: var(--soft); }
  .anatomy-hint:focus { outline: none; }
  .anatomy-hint:focus-visible { outline: 1px solid var(--muted); outline-offset: 1px; }
  @keyframes anatomy-dot { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 45%, transparent); } 70%, 100% { box-shadow: 0 0 0 7px transparent; } }
  /* Clickable parts: two strong pulses every few seconds until the reader first acts; tinted on hover
     and while the hint is hovered or has just been pressed. */
  .anatomy-stage { --fig-hl: #cfe7da; }
  :global(:root[data-theme=dark]) .anatomy-stage { --fig-hl: #2a5244; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme])) .anatomy-stage { --fig-hl: #2a5244; } }
  @keyframes anatomy-hint-edge { 0%, 40%, 100% { stroke: var(--anatomy-hi); stroke-width: var(--anatomy-weight); } 10%, 30% { stroke: var(--anatomy-lit); stroke-width: 2.2px; } 20% { stroke: var(--anatomy-lit); stroke-width: 1.2px; } }
  @keyframes anatomy-hint-fill { 10%, 30% { fill: var(--fig-hl); } }
  .anatomy-stage[data-hint] :global([data-hit] .iso-solid > .iso-edge) { animation: anatomy-hint-edge 4.5s ease-in-out infinite; }
  .anatomy-stage[data-hint] :global([data-hit] .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)) { animation: anatomy-hint-fill 4.5s ease-in-out infinite; }
  .anatomy-stage :global([data-hit]:hover .iso-solid > .iso-edge),
  .anatomy-stage[data-flash] :global([data-hit] .iso-solid > .iso-edge) { animation: none; stroke: var(--anatomy-lit); stroke-width: 2.2px; }
  .anatomy-stage :global([data-hit]:hover .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)),
  .anatomy-stage[data-flash] :global([data-hit] .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)) { animation: none; fill: var(--fig-hl); }
  .anatomy-stage :global([data-hl] .iso-solid > .iso-edge) { animation: none; stroke: var(--anatomy-lit); stroke-width: 2.2px; }
  .anatomy-stage :global([data-hl] .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)) { animation: none; fill: var(--fig-hl); }
  /* Focus: a figure that marks a picked part (data-on) and sets data-focus on its drawing fades every
     other part and the frame, and lights the picked one: a glow (which also reaches parts drawn through
     <use>, where fills can't be restyled) plus an accent fill on parts drawn directly. */
  .anatomy-stage :global(.fig-svg :is(use, path, circle)) { transition: opacity .35s ease; }
  .anatomy-stage :global(.fig-svg[data-focus] use:not([data-on])) { opacity: .14; }
  .anatomy-stage :global(.fig-svg[data-focus] :is(path, circle, ellipse, polygon, line):not([data-on], [data-on] *, defs *, .fig-ripple)) { opacity: .14; }
  .anatomy-stage :global(.fig-svg[data-focus] [data-on]) { filter: drop-shadow(0 0 1.2px var(--anatomy-lit)) drop-shadow(0 0 6px color-mix(in srgb, var(--anatomy-lit) 70%, transparent)); }
  .anatomy-stage :global(.fig-svg[data-focus] [data-on] path:not(.iso-line, .iso-halo)) { fill: color-mix(in srgb, var(--anatomy-lit) var(--fig-focus-mix, 30%), var(--anatomy-paper)); stroke: none; }
  .anatomy-stage :global(.fig-svg[data-focus] [data-on] .iso-line) { stroke: var(--anatomy-lit); }
  :global(:root[data-theme=dark]) .anatomy-stage { --fig-focus-mix: 42%; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme])) .anatomy-stage { --fig-focus-mix: 42%; } }
  .anatomy-stage :global(.fig-svg[data-focus] [data-on] .iso-solid > .iso-edge) { stroke: var(--anatomy-lit); stroke-width: 1.6px; }
  /* Control buttons under the drawing: each presses one of the figure's keys and flashes its part. */
  .anatomy-controls { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 12px; }
  .anatomy-control { min-height: 38px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); color: var(--ink); font: 500 13px/1.2 var(--font-body); cursor: pointer; transition: background-color .15s, border-color .15s, color .15s, transform .1s; }
  .anatomy-control:hover { border-color: var(--green); color: var(--green); }
  .anatomy-control:active { transform: scale(.97); }
  .anatomy-control:focus { outline: none; }
  .anatomy-control:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .anatomy-control[data-fired] { background: var(--green); border-color: var(--green); color: var(--white); }
  @media (prefers-reduced-motion: reduce) {
    .anatomy-hint::before { animation: none; }
    .anatomy-stage[data-hint] :global([data-hit] .iso-solid > .iso-edge) { animation: none; stroke: var(--anatomy-lit); stroke-width: 1.6px; }
    .anatomy-stage[data-hint] :global([data-hit] .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)) { animation: none; fill: var(--fig-hl); }
  }
  .anatomy-stage { position: relative; margin: 6px -10px; touch-action: pan-y; border-radius: 4px; }
  .anatomy-stage:focus { outline: none; }
  .anatomy-stage:focus-visible { outline: 1px solid var(--muted); outline-offset: 2px; }
  .anatomy-stage :global(svg) { display: block; width: 100%; height: auto; }
  .anatomy-loading { position: absolute; inset: 0; display: grid; place-items: center; font-size: 13px; color: var(--muted); }
  .anatomy-stage :global(svg) ~ .anatomy-loading { display: none; }
  .anatomy-stage[data-failed] .anatomy-loading { display: none; }
  /* Press feedback: a ripple, a flash on the pressed part, a toast with what changed, a pulse on the readout. */
  .anatomy-stage :global(svg) { cursor: default; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .anatomy-stage :global(.fig-ripple) { fill: none; stroke: var(--anatomy-lit); stroke-width: 3; pointer-events: none; transform-box: fill-box; transform-origin: center; animation: anatomy-ripple .7s ease-out forwards; }
  @keyframes anatomy-ripple { 0% { transform: scale(.3); opacity: 1; } 100% { transform: scale(2.8); opacity: 0; } }
  .anatomy-stage :global([data-pressed] .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)) { animation: anatomy-press-fill .9s ease-out; }
  .anatomy-stage :global([data-pressed] .iso-solid > .iso-edge) { animation: anatomy-press-edge .9s ease-out; }
  @keyframes anatomy-press-fill { 0%, 30% { fill: color-mix(in srgb, var(--anatomy-lit) 60%, var(--anatomy-paper)); } }
  @keyframes anatomy-press-edge { 0%, 30% { stroke: var(--anatomy-lit); stroke-width: 2.8px; } }
  .anatomy-stage :global(.anatomy-toast) { position: absolute; left: 50%; top: 4px; z-index: 2; width: max-content; max-width: min(92%, 440px); padding: 9px 16px 10px; border-radius: 10px; background: var(--green); color: var(--white); text-align: center; box-shadow: 0 10px 28px rgba(0, 0, 0, .22); opacity: 0; transform: translate(-50%, -10px) scale(.98); transition: opacity .2s ease, transform .3s cubic-bezier(.2, .8, .2, 1); pointer-events: none; }
  .anatomy-stage :global(.anatomy-toast[data-show]) { opacity: 1; transform: translate(-50%, 0) scale(1); }
  .anatomy-stage :global(.anatomy-toast b) { display: block; font: 600 15px/1.3 var(--font-body); letter-spacing: 0; }
  .anatomy-stage :global(.anatomy-toast span) { display: block; margin-top: 3px; font: 12px/1.45 var(--font-mono); opacity: .85; }
  .anatomy-stage :global(.anatomy-toast span:empty) { display: none; }
  .anatomy-foot [data-readout] { padding: 2px 6px; margin: -2px -6px; border-radius: 4px; }
  .anatomy-foot [data-readout][data-bump] { animation: anatomy-bump 1.2s ease-out; }
  @keyframes anatomy-bump { 0%, 25% { background: color-mix(in srgb, var(--green) 28%, transparent); color: var(--ink); } 100% { background: transparent; } }
  @media (prefers-reduced-motion: reduce) {
    .anatomy-stage :global(.fig-ripple) { display: none; }
    .anatomy-stage :global(.anatomy-toast) { transition: none; }
  }
  .anatomy-caption { margin-top: 14px; font-size: 13px; line-height: 1.6; color: var(--muted); max-width: 62ch; }
  .anatomy-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 700px) {
    .anatomy-plate { padding: 14px 14px 12px; }
    .anatomy-stage { margin: 6px -6px; }
    .anatomy-foot { flex-direction: column; align-items: flex-start; gap: 4px; }
    .anatomy-foot [data-readout] { text-align: left; }
    .anatomy-stage :global(.anatomy-toast) { max-width: 94%; padding: 8px 12px 9px; }
    .anatomy-stage :global(.anatomy-toast b) { font-size: 14px; }
    .anatomy-stage :global(.anatomy-toast span) { font-size: 11px; }
  }
</style>
