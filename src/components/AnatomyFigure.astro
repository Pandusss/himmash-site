---
// Interactive isometric drawing of a machine, built with the anatomy kit (see figures/README.md).
// The page carries only the card; the drawing and its script are fetched when the section nears the viewport.
import { type Lang, asset } from '../i18n';
import { figureById } from '../figures';

interface Props { lang: Lang; id: string; num: string }
const { lang, id, num } = Astro.props;
const { text, data } = figureById(id)!;
const t = text[lang];
const payload = JSON.stringify({ ...t.live, label: t.label });
const { width, height, ...rest } = data;
---
<section id="how-it-works" class="section details-layout anatomy-section" aria-labelledby="how-title">
  <div class="anatomy-intro">
    <div class="eyebrow muted">{num} — {t.eyebrow}</div>
    <h2 id="how-title" set:html={t.heading} />
    <p class="anatomy-lead">{t.intro}</p>
    <ul class="anatomy-keys">
      {t.keys.map((key) => <li data-mark={key.mark}><svg viewBox="0 0 16 10" aria-hidden="true"><path d="M2 4.5 8 1.5 14 4.5 14 6 8 9 2 6Z" /><path d="M2 4.5 8 7.5 14 4.5" /></svg>{key.label}</li>)}
    </ul>
  </div>
  <figure class="anatomy">
    <div class="anatomy-plate">
      <div class="anatomy-head" aria-hidden="true">{t.title}</div>
      <div class="anatomy-stage" tabindex="0" role="group" aria-label={t.aria} aria-busy="true" data-hint data-figure-id={id} data-src={asset(`figures/${id}.svg`)} data-text={payload} data-figure={JSON.stringify(rest)} style={`aspect-ratio:${width}/${height}`}>
        <span class="anatomy-live" aria-live="polite"></span>
        <span class="anatomy-loading">{t.loading}</span>
      </div>
      <div class="anatomy-foot"><button type="button" class="anatomy-hint" data-key={t.hintKey ?? ' '}>{t.hint}</button><span data-readout aria-hidden="true">{t.idle}</span></div>
    </div>
    <figcaption class="anatomy-caption">{t.caption}</figcaption>
  </figure>
</section>

<script>
  import '../figures/loader.js';
</script>

<style>
  .anatomy-section { align-items: start; }
  .anatomy-lead { color: var(--muted); font-size: 15px; margin-top: 18px; max-width: 34ch; }
  .anatomy-keys { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 12px; font-size: 14px; color: var(--muted); max-width: 34ch; }
  .anatomy-keys li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; line-height: 1.45; }
  .anatomy-keys svg { width: 18px; margin-top: 3px; fill: var(--white); stroke: var(--muted); stroke-width: 1; stroke-linejoin: round; }
  .anatomy-keys [data-mark='lit'] svg { stroke: var(--green); stroke-width: 1.4; }
  .anatomy { margin: 0; width: 100%; max-width: 560px; }
  .anatomy-plate { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px 16px; }
  .anatomy-head, .anatomy-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; font: 11px/1.4 var(--font-mono); letter-spacing: .06em; color: var(--muted); }
  .anatomy-head { text-transform: uppercase; }
  /* The hint names the part to press; it also works as a button and lights the clickable parts on hover. */
  .anatomy-hint { display: inline-flex; align-items: center; gap: 8px; margin: -6px 0 -6px -8px; padding: 6px 8px; border: 0; border-radius: 4px; background: none; font: inherit; letter-spacing: inherit; text-transform: uppercase; color: var(--green); cursor: pointer; text-align: left; }
  .anatomy-hint::before { content: ""; flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 0 currentColor; animation: anatomy-dot 1.8s ease-out infinite; }
  .anatomy-hint:hover, .anatomy-hint:focus-visible { background: var(--soft); }
  .anatomy-hint:focus { outline: none; }
  .anatomy-hint:focus-visible { outline: 1px solid var(--muted); outline-offset: 1px; }
  @keyframes anatomy-dot { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 45%, transparent); } 70%, 100% { box-shadow: 0 0 0 7px transparent; } }
  /* Clickable parts: two strong pulses every few seconds until the reader first acts; tinted on hover
     and while the hint is hovered or has just been pressed. */
  .anatomy-stage { --fig-hl: #cfe7da; }
  :global(:root[data-theme=dark]) .anatomy-stage { --fig-hl: #2a5244; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme])) .anatomy-stage { --fig-hl: #2a5244; } }
  @keyframes anatomy-hint-edge { 0%, 40%, 100% { stroke: var(--anatomy-hi); stroke-width: var(--anatomy-weight); } 10%, 30% { stroke: var(--anatomy-lit); stroke-width: 2.2px; } 20% { stroke: var(--anatomy-lit); stroke-width: 1.2px; } }
  @keyframes anatomy-hint-fill { 10%, 30% { fill: var(--fig-hl); } }
  .anatomy-stage[data-hint] :global([data-hit] .iso-solid > .iso-edge) { animation: anatomy-hint-edge 4.5s ease-in-out infinite; }
  .anatomy-stage[data-hint] :global([data-hit] .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)) { animation: anatomy-hint-fill 4.5s ease-in-out infinite; }
  .anatomy-stage :global([data-hit]:hover .iso-solid > .iso-edge),
  .anatomy-stage[data-flash] :global([data-hit] .iso-solid > .iso-edge) { animation: none; stroke: var(--anatomy-lit); stroke-width: 2.2px; }
  .anatomy-stage :global([data-hit]:hover .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)),
  .anatomy-stage[data-flash] :global([data-hit] .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)) { animation: none; fill: var(--fig-hl); }
  @media (prefers-reduced-motion: reduce) {
    .anatomy-hint::before { animation: none; }
    .anatomy-stage[data-hint] :global([data-hit] .iso-solid > .iso-edge) { animation: none; stroke: var(--anatomy-lit); stroke-width: 1.6px; }
    .anatomy-stage[data-hint] :global([data-hit] .iso-solid > :is(.iso-fill, .iso-top, .iso-shade)) { animation: none; fill: var(--fig-hl); }
  }
  .anatomy-stage { position: relative; margin: 6px -10px; touch-action: pan-y; border-radius: 4px; }
  .anatomy-stage:focus { outline: none; }
  .anatomy-stage:focus-visible { outline: 1px solid var(--muted); outline-offset: 2px; }
  .anatomy-stage :global(svg) { display: block; width: 100%; height: auto; }
  .anatomy-loading { position: absolute; inset: 0; display: grid; place-items: center; font-size: 13px; color: var(--muted); }
  .anatomy-stage :global(svg) ~ .anatomy-loading { display: none; }
  .anatomy-stage[data-failed] .anatomy-loading { display: none; }
  .anatomy-caption { margin-top: 14px; font-size: 13px; line-height: 1.6; color: var(--muted); max-width: 62ch; }
  .anatomy-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 700px) {
    .anatomy-plate { padding: 14px 14px 12px; }
    .anatomy-stage { margin: 6px -6px; }
    .anatomy-foot { flex-direction: column; align-items: flex-start; gap: 4px; }
    .anatomy-foot [data-readout] { text-align: left; }
  }
</style>
