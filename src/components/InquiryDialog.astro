---
import { type Lang, localePath, useTranslations } from '../i18n';
import { company, phoneDisplay } from '../data/company';
import { CONSENT_VERSION } from '../data/legal';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const f = t.form;
// Without PUBLIC_FORM_ENDPOINT the form prepares an email in the visitor's mail app.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';
const labels = {
  topic: f.mailTopic, contacts: f.sectionContacts, task: f.sectionTask,
  name: f.name, company: f.company, phone: f.phone, email: f.email,
  need: f.need, feedstock: f.feedstock, volume: f.volume, message: f.message, files: f.filesAttached, filesMail: f.filesMail,
};
const errors = {
  name: f.errorName, phone: f.errorPhone, phoneInvalid: f.errorPhoneInvalid, email: f.errorEmail,
  need: f.errorNeed, files: f.errorFiles, consent: f.errorConsent,
};
---
<dialog id="inquiry-dialog" class="inquiry-dialog" aria-labelledby="inquiry-title">
  <button class="dialog-close" type="button" data-close="inquiry-dialog" aria-label={f.close}>×</button>
  <div class="inquiry-layout">
    <div class="inquiry-aside">
      <div class="inquiry-head">
        <div class="eyebrow">{f.eyebrow}</div>
        <h2 id="inquiry-title" set:html={f.title} />
        <p class="inquiry-intro">{f.intro}</p>
        <div class="inquiry-subject"><span>{f.subjectLabel}</span><strong id="inquiry-subject"></strong></div>
      </div>
      <div class="inquiry-direct">
        <p class="inquiry-direct-title">{f.directTitle}</p>
        <a href={`tel:${company.phone}`}>{phoneDisplay(lang)}</a>
        <a href={`mailto:${company.email}`}>{company.email}</a>
        <small>{f.hours}</small>
      </div>
    </div>

    <div class="inquiry-main">
      <div id="form-view">
        <form
          class="inquiry-form"
          id="inquiry-form"
          novalidate
          data-endpoint={endpoint}
          data-mailto={company.email}
          data-mail-subject={f.mailSubject}
          data-errors={JSON.stringify(errors)}
          data-consent-text={`${f.consentMail}: ${f.consentGiven} (${f.consentVersion} ${CONSENT_VERSION})`}
          data-sending={f.sending}
          data-labels={JSON.stringify(labels)}
        >
          {accessKey && <input type="hidden" name="access_key" value={accessKey}>}
          <input type="hidden" name="subject" id="inquiry-subject-field">
          <input type="hidden" name="page" id="inquiry-page-field">
          <input type="hidden" name="lang" value={lang}>
          <input type="hidden" name="consent_version" value={CONSENT_VERSION}>
          <input type="hidden" name="consent_at" id="consent-at-field">
          <div class="hp-field" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>

          <div class="field-grid">
            <div class="field">
              <label for="inquiry-name">{f.name}<span class="req" aria-hidden="true">*</span></label>
              <input id="inquiry-name" name="name" autocomplete="name" required placeholder={f.namePlaceholder} aria-describedby="name-error">
              <p id="name-error" class="field-error" role="alert"></p>
            </div>
            <div class="field">
              <label for="inquiry-phone">{f.phone}<span class="req" aria-hidden="true">*</span></label>
              <input id="inquiry-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder={f.phonePlaceholder} aria-describedby="phone-error">
              <p id="phone-error" class="field-error" role="alert"></p>
            </div>
            <div class="field">
              <label for="inquiry-company">{f.company}</label>
              <input id="inquiry-company" name="company" autocomplete="organization" placeholder={f.companyPlaceholder}>
            </div>
            <div class="field">
              <label for="inquiry-email">{f.email}</label>
              <input id="inquiry-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder={f.emailPlaceholder} aria-describedby="email-error">
              <p id="email-error" class="field-error" role="alert"></p>
            </div>
          </div>

          <fieldset class="field chip-field" id="need-field">
            <legend>{f.need}<span class="req" aria-hidden="true">*</span></legend>
            <div class="chips">
              {f.needs.map((n) => <label class="chip"><input type="radio" name="need" value={n.label} data-key={n.key} required aria-describedby="need-error"><span>{n.label}</span></label>)}
            </div>
            <p id="need-error" class="field-error" role="alert"></p>
          </fieldset>

          <div class="field-grid">
            <div class="field">
              <label for="inquiry-feedstock">{f.feedstock}</label>
              <div class="select">
                <select id="inquiry-feedstock" name="feedstock">
                  <option value="">{f.choose}</option>
                  {f.feedstocks.map((v) => <option>{v}</option>)}
                </select>
              </div>
            </div>
            <div class="field">
              <label for="inquiry-volume">{f.volume}</label>
              <div class="select">
                <select id="inquiry-volume" name="volume">
                  <option value="">{f.choose}</option>
                  {f.volumes.map((v) => <option>{v}</option>)}
                </select>
              </div>
            </div>
          </div>

          <div class="field">
            <label for="inquiry-message">{f.message}</label>
            <textarea id="inquiry-message" name="message" rows="3" placeholder={f.messagePlaceholder}></textarea>
            <div class="file-row">
              <label class="file-attach">
                <input type="file" id="inquiry-files" name="files[]" multiple accept=".jpg,.jpeg,.png,.webp,.heic,.pdf,.doc,.docx,.xls,.xlsx" aria-describedby="files-error files-limit">
                <span class="file-attach-icon" aria-hidden="true">+</span>
                <span>{f.files}</span>
              </label>
              <small id="files-limit">{f.filesLimit}</small>
            </div>
            <div class="file-list" id="inquiry-file-list" hidden>
              <ul></ul>
              <button type="button" class="file-clear" id="inquiry-files-clear">{f.filesClear}</button>
            </div>
            <p id="files-error" class="field-error" role="alert"></p>
          </div>

          <div class="field consent-field">
            <label class="consent-label">
              <input type="checkbox" id="consent-check" name="consent" value="yes" required aria-describedby="consent-error">
              <span>{f.consentPrefix}<a href={localePath(lang, '/consent/')} target="_blank" rel="noopener">{f.consentLink}</a><span class="req" aria-hidden="true">*</span></span>
            </label>
            <p id="consent-error" class="field-error" role="alert"></p>
          </div>
          <div class="form-submit">
            <button class="btn" type="submit"><span class="btn-label">{f.submit}</span> <span class="arrow" aria-hidden="true">↗</span></button>
            <p class="form-note">{f.requiredNote} {f.note} <a href={localePath(lang, '/privacy/')} target="_blank" rel="noopener">{f.policyLink}</a></p>
          </div>
          <p class="field-error send-error" id="send-error" role="alert" hidden>{f.errorSend} <a href={`tel:${company.phone}`}>{company.phoneDisplay.intl}</a> · <a href={`mailto:${company.email}`}>{company.email}</a></p>
        </form>
      </div>
      <div id="success-view" class="success-view" role="status" hidden>
        <div class="success-symbol" aria-hidden="true">✓</div>
        <div class="eyebrow">{f.successEyebrow}</div>
        <h2 set:html={f.successTitle} />
        <p>{f.successText}</p>
        <button class="btn" type="button" data-close="inquiry-dialog">{f.back} <span aria-hidden="true">↗</span></button>
      </div>
      <div id="mailto-view" class="success-view" role="status" hidden>
        <div class="success-symbol" aria-hidden="true">✉</div>
        <div class="eyebrow">{f.mailtoEyebrow}</div>
        <h2 set:html={f.mailtoTitle} />
        <p>{f.mailtoText}</p>
        <p class="mailto-files" id="mailto-files" hidden>{f.mailtoFiles} <b></b></p>
        <p class="mailto-contacts"><a href={`mailto:${company.email}`}>{company.email}</a><a href={`tel:${company.phone}`}>{company.phoneDisplay.intl}</a></p>
        <button class="btn" type="button" data-close="inquiry-dialog">{f.back} <span aria-hidden="true">↗</span></button>
      </div>
    </div>
  </div>
</dialog>
